pipeline {
    agent any

    stages {
        stage('Execute Unit Tests') {
            parallel {
                stage('Unit Tests - Backend') {
                    agent {
                        docker {
                            image 'bugtracker-backend:latest'
                            alwaysPull false
                            args '-e GOCACHE=/tmp/go-build -e GOPATH=/tmp/go'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('bugtracker-backend') {
                            sh '''
                                set -o pipefail
                                go install github.com/jstemmer/go-junit-report@latest
                                export PATH="/tmp/go/bin:$PATH"
                                go test -v ./... 2>&1 | go-junit-report > test-results.xml

                                #Generate coverage report
                                go test -coverprofile=coverage.out -covermode=atomic ./...
                                go tool cover -html=coverage.out -o coverage.html

                                mkdir -p reports
                                mv coverage.html reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit testResults: 'bugtracker-backend/test-results.xml', allowEmptyResults: true
                            publishHTML target: [
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ]
            
                        }
                    }
                }
        stage('Unit Tests - Frontend') {
            agent {
                docker {
                    image 'bugtracker-frontend-test:latest'
                    alwaysPull false
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh '''
                        npm ci
                        npm test
                        mkdir -p reports
                        mv coverage reports/    
                    '''
                }
            }

            post {
             always {
                junit testResults: 'bugtracker-frontend/test-results.xml', allowEmptyResults: true
                publishHTML target: [
                    reportDir: 'bugtracker-frontend/reports/coverage',
                    reportFiles: 'index.html',
                    reportName: 'Frontend Coverage Report'
                                ]
                        }
                    }
                }
            }
        }

        stage('Launch Application'){
            agent any
            steps {
                sh 'docker compose up --build -d'
            }

        }

        stage('API Tests'){
            agent {
                docker {
                    image 'bugtracker-api-tests:latest'
                    alwaysPull false
                    reuseNode true
                    args '-u 0 --network=host'
                }
            }
            steps {
                dir('tests-api') {
                    sh '''
                        npx wait-port http://localhost:8080/api/health -t 30000 -- echo "Backend is up and running"
                        npm ci
                        npx playwright test
                    '''
                }
            }
            post {
                always {
                    junit 'tests-api/test-results/results.xml'
                    publishHTML target: [
                        reportDir: 'tests-api/playwright-report',
                        reportFiles: 'index.html',
                        reportName: 'Playwright API Test Report'
                    ]
                }
            }
        }
        stage('E2E Tests'){
            agent {
                docker {
                    image 'bugtracker-api-tests:latest'
                    alwaysPull false
                    reuseNode true
                    args '-u 0 --network=host'
                }
            }
            steps {
                dir('tests-e2e') {
                    sh '''
                        npm ci
                        npx playwright test
                    '''
                }
            }
            post {
                always {
                    junit 'tests-e2e/test-results/results.xml'
                    publishHTML target: [
                        reportDir: 'tests-e2e/playwright-report',
                        reportFiles: 'index.html',
                        reportName: 'Playwright E2E Test Report'
                    ]
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}