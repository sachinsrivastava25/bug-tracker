pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'bugtracker-backend:latest'
                    alwaysPull false
                    args '-e GOCACHE=/tmp/go-build -e GOPATH=/tmp/go'
                }
            }
            steps {
                dir('bugtracker-backend') {
                    sh 'go test -v ./...'
                }
            }
        }

        stage('Build Frontend Test Image') {
            steps {
                dir('bugtracker-frontend') {
                    sh 'docker build -f Dockerfile.test -t bugtracker-frontend-test:latest .'
                }
            }
        }

        stage('Unit Tests - Frontend') {
            agent {
                docker {
                    image 'bugtracker-frontend-test:latest'
                    alwaysPull false
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh 'npm test'
                }
            }
        }
    }
}
